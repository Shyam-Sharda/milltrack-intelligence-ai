<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>MillTrack Customer Asset Service History</masterLabel>

    <description>Displays read-only Maintenance Log history for the Asset currently open in the MillTrack customer portal.</description>

    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recordId"
                type="String"
                label="Record ID"
                description="On the Asset Detail page, set this value to {!recordId}."
                required="true"
            />

            <property
                name="title"
                type="String"
                label="Component Title"
                default="Service History"
            />

            <property
                name="recordLimit"
                type="Integer"
                label="Maximum Records"
                default="20"
                min="1"
                max="50"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>