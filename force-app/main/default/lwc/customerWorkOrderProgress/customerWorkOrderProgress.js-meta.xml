<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle
    xmlns="http://soap.sforce.com/2006/04/metadata"
>
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Customer Work Order Progress</masterLabel>

    <description>Displays a customer-safe service progress tracker for the current Work Order.</description>

    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                name="recordId"
                type="String"
                label="Work Order Record ID"
                description="Set this value to {!recordId} on the Work Order Detail page."
                required="true"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>