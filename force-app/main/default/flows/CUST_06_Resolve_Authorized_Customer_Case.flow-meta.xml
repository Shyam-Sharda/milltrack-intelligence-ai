        </assignmentItems>
        <assignmentItems>
            <assignToReference>outStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The service request could not be verified at this time.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Prevents an authorized Case lookup when no usable customer-facing Case Number was supplied.</description>
        <name>Is_Requested_Case_Number_Present</name>
        <label>Is Requested Case Number Present?</label>
        <locationX>767</locationX>
        <locationY>254</locationY>
        <defaultConnector>
            <targetReference>Set_Missing_Case_Number_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Case Number Missing</defaultConnectorLabel>
        <rules>
            <name>Case_Number_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmHasRequestedCaseNumber</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Authorized_Customer_Case</targetReference>
            </connector>
            <label>Case Number Present</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the requested Case Number resolved to a Case belonging to the authenticated customer.</description>
        <name>Was_Authorized_Customer_Case_Found</name>
        <label>Was Authorized Customer Case Found?</label>
        <locationX>1147</locationX>
        <locationY>253</locationY>
        <defaultConnector>
            <targetReference>Set_Case_Not_Authorized_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Case Not Authorized</defaultConnectorLabel>
        <rules>
            <name>Authorized_Case_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Authorized_Customer_Case.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Authorized_Case_Result</targetReference>
            </connector>
            <label>Authorized Case Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the trusted Contact supplied by the authenticated customer context exists.</description>
        <name>Was_Verified_Contact_Found</name>
        <label>Was Verified Contact Found?</label>
        <locationX>559</locationX>
        <locationY>255</locationY>
        <defaultConnector>
            <targetReference>Set_Invalid_Contact_Result</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Not Found</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Verified_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Requested_Case_Number_Present</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Returns true only when the requested customer-facing Case Number contains a non-blank value.</description>
        <name>frmHasRequestedCaseNumber</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK(TRIM({!varRequestedCaseNumber})))</expression>
    </formulas>
    <formulas>
        <description>Trims leading and trailing whitespace from the customer-supplied Case Number before authorized Case lookup. Does not otherwise alter the Case Number.</description>
        <name>frmNormalizedRequestedCaseNumber</name>
        <dataType>String</dataType>
        <expression>TRIM({!varRequestedCaseNumber})</expression>
    </formulas>
    <interviewLabel>CUST 06 - Resolve Authorized Customer Case {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
    <label>CUST 06 - Resolve Authorized Customer Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Resolves the requested customer-facing Case Number only when the Case belongs to the credential-verified Contact and that Contact&apos;s Account. A typed Case Number is a selector only and never establishes authorization by itself.</description>
        <name>Get_Authorized_Customer_Case</name>
        <label>Get Authorized Customer Case</label>
        <locationX>1009</locationX>
        <locationY>252</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Authorized_Customer_Case_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_System_Error_Result</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CaseNumber</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmNormalizedRequestedCaseNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Verified_Contact.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Verified_Contact.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Retrieves the Contact identified by the credential-verified customer context. This Contact is the trusted identity used to authorize access to the requested Case.</description>
        <name>Get_Verified_Contact</name>
        <label>Get Verified Contact</label>
        <locationX>425</locationX>
        <locationY>253</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Verified_Contact_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_System_Error_Result</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varVerifiedContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>233</locationY>
        <connector>
            <targetReference>Get_Verified_Contact</targetReference>
        </connector>
    </start>
