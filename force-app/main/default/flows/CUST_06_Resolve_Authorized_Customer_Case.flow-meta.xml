    <assignments>
        <description>Returns the trusted internal Case Id and customer-safe Case information only after authorization has succeeded.</description>
        <name>Set_Authorized_Case_Result</name>
        <label>Set Authorized Case Result</label>
        <locationX>1394</locationX>
        <locationY>251</locationY>
        <assignmentItems>
            <assignToReference>outSuccess</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outStatusCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>AUTHORIZED_CASE_FOUND</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outStatusMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>The service request was verified successfully.</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outCaseId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Authorized_Customer_Case.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outCaseNumber</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Authorized_Customer_Case.CaseNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outCaseStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Authorized_Customer_Case.Status</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Returns the same safe failure result whether the requested Case Number does not exist or belongs to a different customer, preventing record enumeration.</description>
