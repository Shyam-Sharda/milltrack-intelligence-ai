    <formulas>
        <name>frmAppendTechnicianNotes</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!Get_Work_Order.Technician_Notes__c}),
    {!technicianNotes},
    {!Get_Work_Order.Technician_Notes__c} &amp;
    BR() &amp;
    BR() &amp;
    {!technicianNotes}
)</expression>
    </formulas>
    <formulas>
        <name>frmCumulativeLaborHours</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Work_Order.Labor_Hours__c}, 0)
+
BLANKVALUE({!Labor_Hours}, 0)</expression>
