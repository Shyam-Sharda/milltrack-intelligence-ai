    <decisions>
        <name>Part_Eligible_to_Order</name>
        <label>Part Eligible to Order?</label>
        <locationX>1077</locationX>
        <locationY>266</locationY>
        <defaultConnector>
            <targetReference>Part_Not_Eligible_to_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Eligible</defaultConnectorLabel>
        <rules>
            <name>Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Technician_Requested_Part.Order_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Requested</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Parent_Work_Order.Dispatch_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Waiting on Parts</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Order_Technician_Requested_Part_Screen</targetReference>
            </connector>
            <label>Eligible</label>
        </rules>
    </decisions>
