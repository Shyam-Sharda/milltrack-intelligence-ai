    <formulas>
        <name>frmHasRequiredCaseInfo</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  NOT(ISBLANK({!varSubject})),
  NOT(ISBLANK({!varDescription})),
  NOT(ISBLANK({!varOriginalServiceRequest}))
)</expression>
    </formulas>
    <formulas>
        <name>frmNormalizedPriority</name>
        <dataType>String</dataType>
        <expression>CASE(
  LOWER(TRIM({!varPriority})),
  &quot;critical&quot;, &quot;Critical&quot;,
  &quot;high&quot;, &quot;High&quot;,
  &quot;medium&quot;, &quot;Medium&quot;,
  &quot;low&quot;, &quot;Low&quot;,
  &quot;Medium&quot;
)</expression>
    </formulas>
    <formulas>
        <name>frmSafeSubject</name>
        <dataType>String</dataType>
        <expression>LEFT(TRIM({!varSubject}), 255)</expression>
    </formulas>
