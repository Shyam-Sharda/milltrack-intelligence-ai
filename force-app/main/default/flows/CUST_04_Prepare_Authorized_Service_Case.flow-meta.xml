    <decisions>
        <description>Validates that the AI-prepared Case priority is one of the supported Salesforce Case priority values. Invalid or missing values fall back deterministically to Medium.</description>
        <name>Validate_Prepared_Priority</name>
        <label>Validate Prepared Priority</label>
        <locationX>545</locationX>
        <locationY>85</locationY>
        <defaultConnector>
            <targetReference>Default_to_Medium</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid or Missing Priority</defaultConnectorLabel>
        <rules>
            <name>Valid_Prepared_Priority</name>
            <conditionLogic>1 OR 2 OR 3 OR 4</conditionLogic>
            <conditions>
                <leftValueReference>Prepare_Customer_Service_Case_Payload.structuredResponse.priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Critical</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Prepare_Customer_Service_Case_Payload.structuredResponse.priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Prepare_Customer_Service_Case_Payload.structuredResponse.priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Medium</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Prepare_Customer_Service_Case_Payload.structuredResponse.priority</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Low</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Use_Prepared_Priority</targetReference>
            </connector>
            <label>Valid Prepared Priority</label>
        </rules>
    </decisions>
    <description>Prepares the factual Subject, Description, Priority, and Technician Requested values for a Customer AI service request. This helper flow does not query, create, or modify Salesforce records; it returns the prepared values for deterministic chaining into CUST 02 - Create Authorized Service Case.</description>
