)</expression>
    </formulas>
    <formulas>
        <name>Update_Technician_Notes</name>
        <dataType>String</dataType>
        <expression>IF(
    ISBLANK({!Get_Work_Order.Technician_Notes__c}),
    {!Visit_Summary},
    {!Get_Work_Order.Technician_Notes__c}
    &amp; BR() &amp; BR()
    &amp; &quot;Parts Request Visit:&quot;
    &amp; BR()
    &amp; {!Visit_Summary}
)</expression>
    </formulas>
    <formulas>
        <name>Updated_Labor_Hours</name>
