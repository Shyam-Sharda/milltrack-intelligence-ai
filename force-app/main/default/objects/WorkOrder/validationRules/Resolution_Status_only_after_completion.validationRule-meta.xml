<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Resolution_Status_only_after_completion</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISCHANGED(Resolution_Status__c),
    NOT(ISPICKVAL(Dispatch_Status__c,&quot;Completed&quot;)),
    NOT(ISBLANK(TEXT(Resolution_Status__c)))
)</errorConditionFormula>
    <errorMessage>Resolution Status can only be set after the Work Order is completed.</errorMessage>
</ValidationRule>
