<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Asset_On_Completion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL(Dispatch_Status__c,&quot;Completed&quot;),
ISBLANK(AssetId)
)</errorConditionFormula>
    <errorDisplayField>AssetId</errorDisplayField>
    <errorMessage>A machine must be associated with the Work Order before it can be completed.</errorMessage>
</ValidationRule>
